{
  "$schema": "./index.schema.json",
  "plugins": [
    {
      "author": "madbrolab",
      "permissions": {
        "apis": [
          {
            "method": "GET",
            "path": "/api/115/accounts/options",
            "reason": "选择执行任务的主账号、备用号池或指定备用账号"
          },
          {
            "method": "GET",
            "path": "/api/115/directories",
            "reason": "浏览所选账号的 115 云端目录"
          },
          {
            "method": "POST",
            "path": "/api/115/offline/add",
            "reason": "将离线地址添加到所选账号的目标目录"
          },
          {
            "method": "POST",
            "path": "/api/115/share/receive",
            "reason": "将 115 分享链接转存到所选账号的目标目录"
          },
          {
            "method": "POST",
            "path": "/api/notifications/plugin",
            "reason": "通过独立的插件通知反馈转存结果"
          },
          {
            "method": "GET",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "恢复当前安装实例的账号、目录和最近任务状态"
          },
          {
            "method": "PUT",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "保存当前安装实例的账号、目录和最近任务状态"
          }
        ],
        "network": []
      },
      "description": "使用宿主原生账号与目录选择器，将 115 分享链接或离线地址保存到主账号、备用号池或指定备用账号的云目录。",
      "homepage": "https://github.com/madbrolab/dian115",
      "icon_url": "assets/multi-account-transfer-helper.svg",
      "id": "io.github.madbrolab.multi-account-transfer-helper",
      "name": "多账号转存助手",
      "package_url": "packages/multi-account-transfer-helper-1.0.5.d115p",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:plugin@1",
        "autostart": true,
        "trust_level": "sandboxed"
      },
      "sha256": "c04475c5cdf65b35bf6acb51546f539e2e4d4685ad78ae43ead6e1ffe99465b2",
      "tags": [
        "115",
        "transfer",
        "multi-account"
      ],
      "version": "1.0.5"
    }
  ],
  "repository": {
    "homepage": "https://github.com/madbrolab/dian115",
    "id": "madbrolab.dian115",
    "name": "DIAN115 官方市场"
  },
  "schema_version": 1
}
