{
  "$schema": "./index.schema.json",
  "schema_version": 1,
  "repository": {
    "id": "madbrolab.dian115",
    "name": "DIAN115 官方市场",
    "homepage": "https://github.com/madbrolab/dian115"
  },
  "plugins": [
    {
      "id": "io.github.madbrolab.multi-account-transfer-helper",
      "name": "多账号转存助手",
      "version": "1.0.0",
      "description": "选择主账号、备用号池或指定备用账号，将 115 分享链接或离线地址保存到所选账号的指定云目录。",
      "author": "madbrolab",
      "package_url": "packages/multi-account-transfer-helper-1.0.0.d115p",
      "sha256": "1bbb1529d33530b7193b0919d9f53e4c12b71b956a155daff63726a04e160d7e",
      "capabilities": [
        {
          "capability": "accounts.115.use",
          "reason": "列出并选择当前主账号、备用号池或指定备用账号执行 115 操作"
        },
        {
          "capability": "files.cloud.read",
          "reason": "浏览所选 115 账号的云端目录并选择转存目标目录"
        },
        {
          "capability": "transfer.115.create",
          "reason": "创建 115 分享转存任务或离线下载任务"
        },
        {
          "capability": "notifications.plugin.send",
          "reason": "通过宿主的插件通知通道反馈任务提交和最终执行结果"
        },
        {
          "capability": "events.subscribe",
          "reason": "接收本插件创建的转存任务完成或失败事件"
        },
        {
          "capability": "storage.kv",
          "reason": "保存当前账号、目录选择和最近任务状态，供插件界面刷新及重启后恢复"
        }
      ],
      "account_access": [
        "main",
        "backup_pool",
        "backup_select"
      ],
      "tags": [
        "115",
        "transfer",
        "multi-account"
      ]
    }
  ]
}
