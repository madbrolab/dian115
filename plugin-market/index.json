          {"method":"GET","path":"/api/plugin-runtime/storage/:key","reason":"恢复当前安装实例的账号、目录和最近任务状态"},
          {"method":"PUT","path":"/api/plugin-runtime/storage/:key","reason":"保存当前安装实例的账号、目录和最近任务状态"}
