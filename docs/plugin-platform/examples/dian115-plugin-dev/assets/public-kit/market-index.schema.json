{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "DIAN115 v3 source release index", "type": "object", "required": ["schema_version", "repository", "plugins"], "properties": {"schema_version": {"const": 3}, "repository": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "homepage": {"type": "string", "format": "uri"}}}, "plugins": {"type": "array", "items": {"type": "object", "required": ["id", "name", "version", "source_url", "sha256", "delivery", "author", "description", "homepage", "changelog"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128}, "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "author": {"type": "string", "minLength": 1, "description": "作者署名，须与插件清单 author 一致"}, "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "delivery": {"enum": ["source", "encrypted"]}, "declared_usage": {"type": "object"}, "homepage": {"type": "string", "format": "uri", "pattern": "^https?://", "description": "项目主页或反馈地址"}, "changelog": {"type": "string", "minLength": 1, "description": "本版本更新说明"}, "permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["telegram.bot", "wecom", "telegram.account", "network.tcp"]}, "description": "须覆盖清单 permissions 全部申请项"}}}}}}