{
  "schema_version": 3,
  "id": "example.daemon",
  "name": "常驻连接",
  "version": "0.1.0",
  "author": "",
  "description": "开机后保持 WebSocket 连接并转发事件",
  "requires": { "api": "3.7" },
  "settings": [
    { "key": "url", "label": "WebSocket 地址", "type": "url", "required": true, "placeholder": "wss://example.com/events" }
  ],
  "jobs": [{ "id": "listen", "entry": "jobs/listen.js", "daemon": true }],
  "declared_usage": { "purpose": "连接用户配置的地址并发送通知", "sites": "由用户配置" }
}
