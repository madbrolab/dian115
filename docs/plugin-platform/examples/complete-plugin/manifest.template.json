{
  "$schema": "https://raw.githubusercontent.com/madbrolab/dian115/main/docs/plugin-platform/manifest.schema.json",
  "schema_version": 1,
  "id": "example.complete-plugin",
  "name": "完整插件示例",
  "version": "1.0.0",
  "description": "演示状态、动作、任务、事件、通知、Host Storage、本地 HTTP、目录监控、Telegram、常驻模块与回调按钮。",
  "default_locale": "zh-CN",
  "publisher": {
    "name": "Example Publisher",
    "key_id": "ed25519:REPLACED_BY_PACKAGER",
    "url": "https://example.com/plugins"
  },
  "compatibility": {
    "dian115": ">=5.0.53 <6.0.0",
    "plugin_api": "^2.0"
  },
  "runtime": {
    "kind": "wasm",
    "entry": "runtime/plugin.wasm",
    "protocol": "dian115:wasm@1",
    "startup_timeout_ms": 10000,
    "shutdown_timeout_ms": 5000,
    "timeout_ms": 300000,
    "background_timeout_ms": 300000,
    "max_concurrency": 1,
    "restart_policy": "on-failure",
    "memory_mb": 64,
    "resident": false
  },
  "permissions": {
    "apis": [
      {
        "method": "POST",
        "path": "/api/notifications/plugin",
        "reason": "发送由用户主动触发的测试通知"
      },
      {
        "method": "POST",
        "path": "/api/plugin-runtime/watches",
        "reason": "创建用户在插件界面配置的目录监控"
      },
      {
        "method": "GET",
        "path": "/api/plugin-runtime/storage/:key",
        "reason": "读取插件自己的 Host Storage 示例数据"
      },
      {
        "method": "PUT",
        "path": "/api/plugin-runtime/storage/:key",
        "reason": "保存插件自己的 Host Storage 示例数据"
      },
      {
        "method": "GET",
        "path": "/api/plugin-runtime/http/cookies",
        "reason": "Read this installation cookie session"
      },
      {
        "method": "PUT",
        "path": "/api/plugin-runtime/http/cookies",
        "reason": "Set this installation cookie session"
      },
      {
        "method": "DELETE",
        "path": "/api/plugin-runtime/http/cookies",
        "reason": "Explicitly clear this account session"
      },
      {
        "method": "GET",
        "path": "/api/plugin-runtime/http/cookiecloud",
        "reason": "Inspect local CookieCloud domains"
      },
      {
        "method": "POST",
        "path": "/api/plugin-runtime/http/cookiecloud/import",
        "reason": "Explicitly import a selected domain"
      },
      {
        "method": "POST",
        "path": "/api/plugin-runtime/http/cookiecloud/export",
        "reason": "Explicitly write selected domains back"
      },
      {
        "method": "POST",
        "path": "/api/plugin-runtime/http/render",
        "reason": "Render on demand using configured FlareSolverr"
      },
      {
        "method": "GET",
        "path": "/api/plugin-runtime/http/sites",
        "reason": "安装后读取、添加、修改或删除用户自定义的站点地址"
      },
      {
        "method": "PUT",
        "path": "/api/plugin-runtime/http/sites",
        "reason": "安装后读取、添加、修改或删除用户自定义的站点地址"
      },
      {
        "method": "DELETE",
        "path": "/api/plugin-runtime/http/sites",
        "reason": "安装后读取、添加、修改或删除用户自定义的站点地址"
      },
      {
        "method": "GET",
        "path": "/api/plugin-runtime/http/cache",
        "reason": "查看或按用户要求清空本插件的 HTTP 响应缓存"
      },
      {
        "method": "DELETE",
        "path": "/api/plugin-runtime/http/cache",
        "reason": "查看或按用户要求清空本插件的 HTTP 响应缓存"
      }
    ],
    "network": [
      {
        "origin": "http://127.0.0.1:8080",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "演示通过宿主 Broker 访问容器内或局域网本地服务"
      },
      {
        "origin": "https://site.example",
        "methods": [
          "GET",
          "POST"
        ],
        "proxy_mode": "system",
        "reason": "Declare the example site scope for explicit CookieCloud actions"
      }
    ]
  },
  "ui": {
    "mode": "page",
    "entry": "frontend/dist/index.html",
    "assets_root": "frontend/dist",
    "icon": "frontend/icon.svg"
  },
  "events": [
    "files.changed",
    "telegram.callback"
  ],
  "telegram": {
    "commands": [
      {
        "command": "plugin_example",
        "description": "打开完整插件示例"
      }
    ],
    "keywords": [
      {
        "keyword": "完整插件示例",
        "match": "exact"
      }
    ]
  },
  "jobs": [
    {
      "id": "refresh",
      "handler": "refresh",
      "recovery_handler": "refresh-recover",
      "default_schedule": "*/15 * * * *",
      "allow_overlap": false
    }
  ],
  "homepage": "https://example.com/plugins/complete-plugin",
  "repository": "https://example.com/source/complete-plugin",
  "license": "MIT",
  "tags": [
    "example",
    "automation"
  ]
}
