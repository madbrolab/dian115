{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dian115.example/schemas/plugin-manifest-v1.json",
  "title": "DIAN115 Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "default_locale",
    "publisher",
    "compatibility",
    "runtime",
    "permissions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "default_locale": {
      "type": "string",
      "description": "Language of package-authored manifest and UI text in v1.",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "publisher": {
      "$ref": "#/$defs/publisher"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "runtime": {
      "$ref": "#/$defs/wasmRuntime",
      "description": "The plugin module is packaged in the .d115p archive and loaded by the in-process DIAN115 WASM supervisor."
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "ui": {
      "$ref": "#/$defs/ui"
    },
    "events": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      }
    },
    "jobs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/job"
      }
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "maxLength": 500
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      }
    }
  },
  "$defs": {
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "key_id": {
          "type": "string",
          "minLength": 12,
          "maxLength": 160,
          "pattern": "^ed25519:[A-Za-z0-9_-]+$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dian115",
        "plugin_api"
      ],
      "properties": {
        "dian115": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "plugin_api": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "wasmRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entry",
        "abi"
      ],
      "properties": {
        "kind": {
          "const": "wasm"
        },
        "entry": {
          "$ref": "#/$defs/packagePath"
        },
        "abi": {
          "const": "dian115:plugin@1"
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64,
          "default": 32
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "default": 10000
        },
        "background_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 300000
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "default": 1
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "安装时整体确认的精确接口和外部网络声明。宿主仅允许登记目录中的 METHOD + path。",
      "additionalProperties": false,
      "required": ["apis", "network"],
      "properties": {
        "apis": {
          "type": "array", "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/apiPermission" }
        },
        "network": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": { "$ref": "#/$defs/networkPermission" }
        }
      }
    },
    "apiPermission": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "path", "reason"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "minLength": 5, "maxLength": 240, "pattern": "^/api/[A-Za-z0-9._~:/{}?=&-]+$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "networkPermission": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "methods", "reason"],
      "properties": {
        "origin": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^https://[^/]+$" },
        "methods": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] } },
        "proxy_mode": { "type": "string", "enum": ["direct", "system", "required"], "default": "system" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/packagePath"
        },
        "icon": {
          "$ref": "#/$defs/packagePath"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handler"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "handler": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "default_schedule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?:\\*(?:/(?:[1-9]|[1-5][0-9]))?|(?:[0-9]|[1-5][0-9])(?:-(?:[0-9]|[1-5][0-9]))?(?:/(?:[1-9]|[1-5][0-9]))?)(?:,(?:\\*(?:/(?:[1-9]|[1-5][0-9]))?|(?:[0-9]|[1-5][0-9])(?:-(?:[0-9]|[1-5][0-9]))?(?:/(?:[1-9]|[1-5][0-9]))?))* (?:\\*(?:/(?:[1-9]|1[0-9]|2[0-3]))?|(?:[0-9]|1[0-9]|2[0-3])(?:-(?:[0-9]|1[0-9]|2[0-3]))?(?:/(?:[1-9]|1[0-9]|2[0-3]))?)(?:,(?:\\*(?:/(?:[1-9]|1[0-9]|2[0-3]))?|(?:[0-9]|1[0-9]|2[0-3])(?:-(?:[0-9]|1[0-9]|2[0-3]))?(?:/(?:[1-9]|1[0-9]|2[0-3]))?))* (?:\\*(?:/(?:[1-9]|[12][0-9]|3[01]))?|(?:[1-9]|[12][0-9]|3[01])(?:-(?:[1-9]|[12][0-9]|3[01]))?(?:/(?:[1-9]|[12][0-9]|3[01]))?)(?:,(?:\\*(?:/(?:[1-9]|[12][0-9]|3[01]))?|(?:[1-9]|[12][0-9]|3[01])(?:-(?:[1-9]|[12][0-9]|3[01]))?(?:/(?:[1-9]|[12][0-9]|3[01]))?))* (?:\\*(?:/(?:[1-9]|1[0-2]))?|(?:[1-9]|1[0-2])(?:-(?:[1-9]|1[0-2]))?(?:/(?:[1-9]|1[0-2]))?)(?:,(?:\\*(?:/(?:[1-9]|1[0-2]))?|(?:[1-9]|1[0-2])(?:-(?:[1-9]|1[0-2]))?(?:/(?:[1-9]|1[0-2]))?))* (?:\\*(?:/[1-6])?|[0-6](?:-[0-6])?(?:/[1-6])?)(?:,(?:\\*(?:/[1-6])?|[0-6](?:-[0-6])?(?:/[1-6])?))*$",
          "description": "DIAN115 cron v1: five numeric fields (minute hour day-of-month month day-of-week), with wildcard, list, ascending range, and step syntax."
        },
        "allow_overlap": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9._-])?$"
    }
  }
}
