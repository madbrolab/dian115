{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/madbrolab/dian115/main/docs/plugin-platform/ui-schema-v1.schema.json",
  "title": "DIAN115 Declarative Plugin UI v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "navigation",
    "views"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "const": 1
    },
    "navigation": {
      "$ref": "#/$defs/navigation"
    },
    "appearance": {
      "$ref": "#/$defs/appearance"
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/view"
      }
    }
  },
  "$defs": {
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/label"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "badge_source": {
          "$ref": "#/$defs/source"
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string",
          "enum": ["system", "blue", "green", "amber", "red", "violet", "cyan", "neutral"],
          "default": "system"
        },
        "density": {
          "type": "string",
          "enum": ["comfortable", "compact"],
          "default": "comfortable"
        },
        "surface": {
          "type": "string",
          "enum": ["plain", "soft", "glass"],
          "default": "soft"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["stack", "grid"],
          "default": "stack"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 2
        },
        "gap": {
          "type": "string",
          "enum": ["compact", "normal", "spacious"],
          "default": "normal"
        },
        "header": {
          "type": "string",
          "enum": ["hero", "compact", "none"],
          "default": "hero"
        },
        "max_width": {
          "type": "string",
          "enum": ["full", "wide", "narrow"],
          "default": "wide"
        }
      }
    },
    "statusPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["plain", "card", "metric"],
          "default": "plain"
        },
        "span": { "$ref": "#/$defs/presentationSpan" },
        "tone": { "$ref": "#/$defs/presentationTone" },
        "icon": { "$ref": "#/$defs/icon" }
      }
    },
    "formPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["plain", "card"],
          "default": "plain"
        },
        "span": { "$ref": "#/$defs/presentationSpan" },
        "tone": { "$ref": "#/$defs/presentationTone" },
        "icon": { "$ref": "#/$defs/icon" }
      }
    },
    "tablePresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["plain", "card", "table", "cards", "picker"],
          "default": "plain"
        },
        "span": { "$ref": "#/$defs/presentationSpan" },
        "tone": { "$ref": "#/$defs/presentationTone" },
        "icon": { "$ref": "#/$defs/icon" }
      }
    },
    "logPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["plain", "card", "console"],
          "default": "plain"
        },
        "span": { "$ref": "#/$defs/presentationSpan" },
        "tone": { "$ref": "#/$defs/presentationTone" },
        "icon": { "$ref": "#/$defs/icon" }
      }
    },
    "progressPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["plain", "card", "bar"],
          "default": "plain"
        },
        "span": { "$ref": "#/$defs/presentationSpan" },
        "tone": { "$ref": "#/$defs/presentationTone" },
        "icon": { "$ref": "#/$defs/icon" }
      }
    },
    "actionsPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["plain", "card", "toolbar", "stack"],
          "default": "plain"
        },
        "span": { "$ref": "#/$defs/presentationSpan" },
        "tone": { "$ref": "#/$defs/presentationTone" },
        "icon": { "$ref": "#/$defs/icon" }
      }
    },
    "presentationSpan": {
      "oneOf": [
        { "const": "full" },
        { "type": "integer", "minimum": 1, "maximum": 4 }
      ],
      "default": "full"
    },
    "presentationTone": {
      "type": "string",
      "enum": ["default", "primary", "info", "success", "warning", "danger"],
      "default": "default"
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        }
      }
    },
    "section": {
      "oneOf": [
        {
          "$ref": "#/$defs/statusSection"
        },
        {
          "$ref": "#/$defs/formSection"
        },
        {
          "$ref": "#/$defs/tableSection"
        },
        {
          "$ref": "#/$defs/logSection"
        },
        {
          "$ref": "#/$defs/progressSection"
        },
        {
          "$ref": "#/$defs/actionsSection"
        }
      ]
    },
    "sectionBaseProperties": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "statusSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "fields"
      ],
      "properties": {
        "type": {
          "const": "status"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "presentation": {
          "$ref": "#/$defs/statusPresentation"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/displayField"
          }
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "formSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "submit_action",
        "fields"
      ],
      "properties": {
        "type": {
          "const": "form"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "presentation": {
          "$ref": "#/$defs/formPresentation"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "submit_action": {
          "$ref": "#/$defs/id"
        },
        "submit_label": {
          "$ref": "#/$defs/label"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/formField"
          }
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "tableSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "columns"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "presentation": {
          "$ref": "#/$defs/tablePresentation"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "row_key": {
          "$ref": "#/$defs/id"
        },
        "selected_source": {
          "$ref": "#/$defs/source"
        },
        "selected_row_key": {
          "$ref": "#/$defs/source"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/displayField"
          }
        },
        "row_actions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "page_size": {
          "type": "integer",
          "minimum": 5,
          "maximum": 200,
          "default": 50
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      },
      "dependentRequired": {
        "selected_source": ["selected_row_key"],
        "selected_row_key": ["selected_source"]
      }
    },
    "logSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source"
      ],
      "properties": {
        "type": {
          "const": "log"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "presentation": {
          "$ref": "#/$defs/logPresentation"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "max_rows": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1000,
          "default": 200
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "progressSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source"
      ],
      "properties": {
        "type": {
          "const": "progress"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "presentation": {
          "$ref": "#/$defs/progressPresentation"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "cancel_action": {
          "$ref": "#/$defs/id"
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "actionsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actions"
      ],
      "properties": {
        "type": {
          "const": "actions"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "presentation": {
          "$ref": "#/$defs/actionsPresentation"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "displayField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/source"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "format": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "boolean",
            "datetime",
            "bytes",
            "duration",
            "status",
            "percent"
          ],
          "default": "text"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "control"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "control": {
          "type": "string",
          "enum": [
            "text",
            "textarea",
            "number",
            "switch",
            "select",
            "multiselect",
            "secret-ref",
            "account-picker",
            "directory-picker"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "control": { "enum": ["text", "textarea"] } }
          },
          "then": {
            "properties": {
              "min": false,
              "max": false,
              "step": false,
              "options": false
            }
          }
        },
        {
          "if": {
            "properties": { "control": { "const": "number" } }
          },
          "then": {
            "properties": {
              "min_length": false,
              "max_length": false,
              "options": false
            }
          }
        },
        {
          "if": {
            "properties": { "control": { "enum": ["switch", "secret-ref"] } }
          },
          "then": {
            "properties": {
              "min": false,
              "max": false,
              "step": false,
              "min_length": false,
              "max_length": false,
              "options": false
            }
          }
        },
        {
          "if": {
            "properties": { "control": { "enum": ["select", "multiselect"] } }
          },
          "then": {
            "required": ["options"],
            "properties": {
              "options": true,
              "min": false,
              "max": false,
              "step": false,
              "min_length": false,
              "max_length": false
            }
          }
        },
        {
          "if": {
            "properties": { "control": { "enum": ["account-picker", "directory-picker"] } }
          },
          "then": {
            "properties": {
              "min": false,
              "max": false,
              "step": false,
              "min_length": false,
              "max_length": false
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "style": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "danger"
          ],
          "default": "secondary"
        },
        "confirm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "message"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/label"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "requires_capabilities": {
          "$ref": "#/$defs/apiList"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "operator",
        "value"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "truthy",
            "falsy"
          ]
        },
        "value": {}
      }
    },
    "apiList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "anyOf": [
          { "pattern": "^/api/[A-Za-z0-9._~:/{}?=&-]+$" },
          { "pattern": "^https://[^/]+$" }
        ]
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
