{
  "schema_version": 1,
  "readme_url": "https://github.com/madbrolab/dian115/blob/main/online-rules/category/README.md",
  "rules": [
    {
      "id": "standard",
      "name": "标准完整分类",
      "description": "与项目默认模板保持一致，覆盖电影和电视剧规则，不修改当前子分类与 Emby 设置。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/standard.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["标准", "完整"]
    },
    {
      "id": "compact",
      "name": "精简一级分类",
      "description": "类型目录下仅使用一级静态分类，适合控制媒体库数量。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/compact.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["精简"]
    },
    {
      "id": "minimal",
      "name": "极简三分类",
      "description": "每种媒体只保留两个常用特殊分类和一个兜底目录，适合追求最少目录与媒体库的用户。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/minimal.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["极简", "一级目录"]
    },
    {
      "id": "region",
      "name": "地区优先分类",
      "description": "按 TMDB 制片国家/地区划分华语、日韩、东南亚、南亚、欧美及大洋洲，全部保持一级目录。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/region.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["地区", "一级目录"]
    },
    {
      "id": "genre",
      "name": "题材优先分类",
      "description": "按动画、纪实、科幻、悬疑犯罪、动作等 TMDB 题材首次命中分类，适合按内容类型浏览。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/genre.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["题材", "一级目录"]
    },
    {
      "id": "family",
      "name": "亲子与分级隔离",
      "description": "优先隔离成人、成熟和分级缺失内容，再划分儿童与家庭内容；依赖 TMDB 分级完整度。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/family.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["亲子", "内容分级", "二级目录"]
    },
    {
      "id": "documentary-variety",
      "name": "纪实综艺优先",
      "description": "集中管理纪录片、音乐演出、新闻、综艺和脱口秀，剧情类内容保持精简兜底。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/documentary-variety.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["纪实", "综艺", "二级目录"]
    },
    {
      "id": "anime-focused",
      "name": "动漫细分分类",
      "description": "按产地细分电影动画和剧集动漫，真人影视只保留少量目录，适合动漫收藏为主的用户。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/anime-focused.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["动漫", "产地", "二级目录"]
    },
    {
      "id": "runtime",
      "name": "按时长分类",
      "description": "利用首次命中顺序划分短片、常规、长片和超长内容；时长缺失时进入独立兜底目录。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/runtime.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["时长", "一级目录"]
    },
    {
      "id": "decade",
      "name": "标准分类 + 年代",
      "description": "在标准分类后追加年代子目录；只修改电影和电视剧的年代子分类开关，其余全局设置保持本地值。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/decade.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["详细", "年代"]
    },
    {
      "id": "rating-tier",
      "name": "精简分类 + 评分段",
      "description": "使用少量静态分类，并在其后追加 TMDB 评分段目录；会覆盖电影和电视剧的评分子分类开关。",
      "url": "https://raw.githubusercontent.com/madbrolab/dian115/main/online-rules/category/rating-tier.yaml",
      "media_types": ["movie", "tv"],
      "tags": ["精简", "评分", "动态层级"]
    }
  ]
}
